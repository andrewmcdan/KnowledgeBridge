root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{ts,tsx,js,jsx,json,css,scss,html,yml,yaml}]
indent_style = space
indent_size = 4

[*.java]
indent_style = tab
indent_size = 4
tab_width = 4

[*.{md,properties}]
indent_style = space
indent_size = 4

[*.{bat,cmd}]
end_of_line = crlf
