# Root configuration for Docker Compose and scripts/start-dev.*.
# Copy to .env; keep .env untracked. Shell environment variables take precedence.
# These defaults match the existing local databases.
POSTGRES_DB=knowledgebridge
POSTGRES_USER=knowledgebridge
POSTGRES_PASSWORD=knowledgebridge
POSTGRES_PORT=5432

# gbrain has a separate database/role on the same PostgreSQL server.
# Use URL-safe characters for this password (it is part of a connection URL).
GBRAIN_DB_PASSWORD=gbrain-local
GBRAIN_PORT=3131

# Editing passwords here does not change passwords in an initialized database.


OPENAI_API_KEY=