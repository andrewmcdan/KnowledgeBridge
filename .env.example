# Root configuration for Docker Compose and scripts/start-dev.*.
# Copy to .env; keep .env untracked. Shell environment variables take precedence.
# These defaults match the existing local databases.
POSTGRES_DB=knowledgebridge
POSTGRES_USER=knowledgebridge
POSTGRES_PASSWORD=knowledgebridge
POSTGRES_PORT=5432

# gbrain has a separate database/role on the same PostgreSQL server.
# Use URL-safe characters for this password (it is part of a connection URL).
GBRAIN_DB_PASSWORD=gbrain-local
GBRAIN_PORT=3131

# Editing passwords here does not change passwords in an initialized database.

# Secret used to sign backend JWTs (HS256). Use at least 32 random characters.
KNOWLEDGEBRIDGE_JWT_SECRET=change-me-local-development-secret-at-least-32-bytes

# API keys for external services. Keep these secret and do not commit real keys to version control.
# Set OPENROUTER_API_KEY or OPENAI_API_KEY for gbrain embeddings and synthesis.
# OpenRouter is used when both are set. Only the gbrain container receives these keys.
OPENAI_API_KEY=
OPENROUTER_API_KEY=
OPENROUTER_REFERER=http://localhost:3000
OPENROUTER_TITLE=KnowledgeBridge

# gbrain semantic-search configuration. Leave the models empty to use the defaults
# for the available key: OpenRouter uses openrouter:openai/text-embedding-3-small and
# openrouter:anthropic/claude-haiku-4.5; OpenAI uses openai:text-embedding-3-small and
# openai:gpt-4o-mini. Both embedding routes serve the same model at 1536 dimensions.
# Changing the embedding model or dimensions on an initialized brain requires the
# supported gbrain embedding migration workflow.
GBRAIN_EMBEDDING_MODEL=
GBRAIN_EMBEDDING_DIMENSIONS=1536
GBRAIN_SYNTHESIS_MODEL=

# Created by scripts/provision-gbrain.ps1. The secret belongs only in .env.
GBRAIN_OAUTH_CLIENT_ID=
GBRAIN_OAUTH_CLIENT_SECRET=
GBRAIN_OAUTH_TOKEN_URL=http://localhost:3131/token

# Optional backend gbrain adapter overrides. Spring reads these from the process
# environment and defaults to the values shown (see application.properties).
# Docker Compose sets GBRAIN_BASE_URL to the internal http://gbrain:3131.
# GBRAIN_ENABLED=true
# GBRAIN_BASE_URL=http://localhost:3131
# Timeouts are ISO-8601 durations; synthesis is an LLM call with its own limit.
# GBRAIN_CONNECT_TIMEOUT=PT2S
# GBRAIN_READ_TIMEOUT=PT30S
# GBRAIN_SYNTHESIS_TIMEOUT=PT120S
# Larger responses are rejected as protocol failures.
# GBRAIN_MAX_RESPONSE_SIZE=4MB
# Retries apply only to safe reads, never to writes or synthesis.
# GBRAIN_RETRY_MAX_ATTEMPTS=3
# GBRAIN_RETRY_MAX_BACKOFF=PT5S
# mcp indexes content in gbrain; in-memory is a local stand-in when gbrain is
# unavailable (nothing is searchable and contents are lost on restart).
# GBRAIN_MODE=mcp
