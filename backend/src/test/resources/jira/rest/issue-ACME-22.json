            "content": [
                {
                    "type": "paragraph",
                    "content": [
                        {
                            "type": "text",
                            "text": "The onboarding tracker starts the ten-business-day handoff clock when sales makes the first introduction. Per the Compass plan, the clock starts only once all customer prerequisites are complete; an informal sales introduction or unsigned proposal does not start it."
                        }
                    ]
                },
                {
                    "type": "heading",
                    "attrs": {
                        "level": 2
                    },
                    "content": [
                        {
                            "type": "text",
                            "text": "Expected"
                        }
                    ]
                },
                {
                    "type": "bulletList",
                    "content": [
                        {
                            "type": "listItem",
                            "content": [
                                {
                                    "type": "paragraph",
                                    "content": [
                                        {
                                            "type": "text",
                                            "text": "Clock starts when the last prerequisite is marked complete"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "type": "listItem",
                            "content": [
                                {
                                    "type": "paragraph",
                                    "content": [
                                        {
                                            "type": "text",
                                            "text": "Missing prerequisites are reported separately from execution delays"
                                        }
                                    ]
                                }
                            ]
                        }
                    ]
                }
            ]
        },
